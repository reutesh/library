SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-secret-key
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional — "add books from a photo" uses Google's free Gemini tier when this key is set
# (get one at https://aistudio.google.com) — needed on the hosted site.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Without a Gemini key, scanning uses a free local vision model via Ollama (https://ollama.com)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_AUTOSTART=false   # don't start Ollama together with the app
